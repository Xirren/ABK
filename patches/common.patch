+CONFIG_IP6_NF_TARGET_NPT=y                # IPv6 NPTv6 前缀转换
+
+### IPVS（Linux 虚拟服务器）
+CONFIG_IP_VS=y                            # IPVS 核心
+CONFIG_NETFILTER_XT_MATCH_IPVS=y          # iptables IPVS 匹配
+CONFIG_IP_VS_IPV6=y                       # IPv6 支持
+CONFIG_IP_VS_PROTO_TCP=y                  # TCP 负载均衡
+CONFIG_IP_VS_PROTO_UDP=y                  # UDP 负载均衡
+CONFIG_IP_VS_PROTO_SCTP=y                 # SCTP 负载均衡
+CONFIG_IP_VS_PROTO_ESP=y                  # ESP 负载均衡
+CONFIG_IP_VS_PROTO_AH=y                   # AH 负载均衡
+CONFIG_IP_VS_RR=y                         # 轮询调度算法
+CONFIG_IP_VS_WRR=y                        # 加权轮询
+CONFIG_IP_VS_LC=y                         # 最小连接
+CONFIG_IP_VS_WLC=y                        # 加权最小连接
