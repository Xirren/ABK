+#必需项 ABI hack造成了强制依赖,关闭炸abi
+CONFIG_CGROUP_MISC=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_PERF=y
+
+#内核参数 DOCKER支持，关闭v1控制器
+#CONFIG_CMDLINE="console=ttynull stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off kvm-arm.mode=protected bootconfig cgroup_no_v1=cpu,cpuset,io,memory"
+#DROIDSPACES 支持
+CONFIG_PID_NS=y
+CONFIG_SYSVIPC=y
+CONFIG_DEVTMPFS=y
+CONFIG_POSIX_MQUEUE=y
+
+#如果要在droidspaces跑docker开这个
+CONFIG_USER_NS=y
+
+#用于更多容器应用支持 按需取用
+### 网络过滤与 nftables 框架
+CONFIG_BRIDGE_NETFILTER=y                 # 桥接网络包经过 netfilter 框架
+CONFIG_NF_TABLES=y                        # nftables 框架（替代 iptables）
+CONFIG_NF_TABLES_INET=y                   # nftables 支持 inet 表（同时处理 IPv4/IPv6）
+CONFIG_NF_TABLES_NETDEV=y                 # nftables 支持 netdev 表（入口点流量控制）
+CONFIG_NFT_NUMGEN=y                       # nftables 数值生成器
+CONFIG_NFT_CT=y                           # nftables 连接跟踪匹配
+CONFIG_NFT_CONNLIMIT=y                    # nftables 连接数限制
+CONFIG_NFT_LIMIT=y                        # nftables 速率限制
+CONFIG_NFT_MASQ=y                         # nftables 伪装（MASQUERADE）
+CONFIG_NFT_REDIR=y                        # nftables 重定向
+CONFIG_NFT_TUNNEL=y                       # nftables 隧道匹配
+CONFIG_NFT_QUEUE=y                        # nftables 队列（送往用户态）
+CONFIG_NFT_QUOTA=y                        # nftables 配额
+CONFIG_NFT_REJECT=y                       # nftables 拒绝（REJECT）
+CONFIG_NFT_COMPAT=y                       # nftables 兼容 iptables 表达式
+CONFIG_NFT_HASH=y                         # nftables 哈希表
+CONFIG_NFT_XFRM=y                         # nftables IPsec 策略匹配
+CONFIG_NFT_SOCKET=y                       # nftables socket 匹配（如透明代理）
+CONFIG_NFT_OSF=y                          # nftables 操作系统指纹匹配
+CONFIG_NFT_TPROXY=y                       # nftables 透明代理
+CONFIG_NFT_SYNPROXY=y                     # nftables SYN 代理（防 SYN flood）
+CONFIG_NF_TABLES_IPV4=y                   # nftables IPv4 支持
+CONFIG_NF_TABLES_ARP=y                    # nftables ARP 支持
+CONFIG_NF_TABLES_IPV6=y                   # nftables IPv6 支持
+CONFIG_NF_TABLES_BRIDGE=y                 # nftables 桥接支持
+CONFIG_NFT_BRIDGE_REJECT=y                # nftables 桥接层 REJECT
+CONFIG_NFT_NAT=y                          # nftables NAT 支持
+CONFIG_NFT_FIB=y                          # nftables FIB（路由查找）
+CONFIG_NFT_FIB_IPV4=y                     # nftables IPv4 FIB
+CONFIG_NFT_FIB_IPV6=y                     # nftables IPv6 FIB
+CONFIG_NFT_LOG=y                          # nftables 日志记录
+CONFIG_NFT_FIB_INET=y                     # nftables inet 表 FIB
+CONFIG_NF_DUP_NETDEV=y                    # 包复制（netdev 层）
+CONFIG_NFT_DUP_NETDEV=y                   # nftables netdev 包复制
+CONFIG_NFT_FWD_NETDEV=y                   # nftables netdev 转发
+CONFIG_NFT_FIB_NETDEV=y                   # nftables netdev FIB 查找
+CONFIG_NFT_REJECT_NETDEV=y                # nftables netdev 拒绝
+CONFIG_NFT_DUP_IPV4=y                     # nftables IPv4 包复制
+CONFIG_NFT_DUP_IPV6=y                     # nftables IPv6 包复制
+
+### 旧式 xtables / iptables 兼容与扩展
+CONFIG_NETFILTER_XTABLES_COMPAT=y         # xtables 兼容旧版用户空间工具
+CONFIG_IP_NF_MATCH_AH=y                   # IPv4 AH 扩展头匹配
+CONFIG_IP_NF_TARGET_SYNPROXY=y            # IPv4 SYNPROXY 目标
+CONFIG_IP_NF_TARGET_ECN=y                 # IPv4 ECN 修改
+CONFIG_IP_NF_TARGET_TTL=y                 # IPv4 TTL 修改
+CONFIG_NETFILTER_XT_MATCH_RECENT=y        # recent 匹配（动态列表）
+CONFIG_NETFILTER_XT_TARGET_AUDIT=y        # audit 目标（审计日志）
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y     # checksum 目标（重新计算校验和）
+CONFIG_NETFILTER_XT_TARGET_HMARK=y        # HMARK 目标（基于哈希选择路径）
+CONFIG_NETFILTER_XT_TARGET_LED=y          # LED 触发（根据包匹配闪烁）
+CONFIG_NETFILTER_XT_TARGET_RATEEST=y      # rateest 目标（速率估计）
+CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y  # TCP 选项剥离
+CONFIG_NETFILTER_XT_MATCH_CGROUP=y        # cgroup 匹配
+CONFIG_NETFILTER_XT_MATCH_CLUSTER=y       # 集群匹配
+CONFIG_NETFILTER_XT_MATCH_CPU=y           # CPU ID 匹配
+CONFIG_NETFILTER_XT_MATCH_DEVGROUP=y      # 设备组匹配
+CONFIG_NETFILTER_XT_MATCH_IPCOMP=y        # IPComp 协议匹配
+CONFIG_NETFILTER_XT_MATCH_NFACCT=y        # nfacct 记账匹配
+CONFIG_NETFILTER_XT_MATCH_OSF=y           # OS 指纹匹配
+CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y       # 物理设备匹配（桥接场景）
+CONFIG_NETFILTER_XT_MATCH_RATEEST=y       # 速率估计匹配
+CONFIG_NETFILTER_XT_MATCH_REALM=y         # 路由领域匹配
+CONFIG_NETFILTER_XT_MATCH_TCPMSS=y        # TCP MSS 调整
+
+### 连接跟踪（Conntrack）与辅助模块
+CONFIG_NF_CONNTRACK_ZONES=y               # 连接跟踪区域（用于隔离 CT）
+CONFIG_NF_CONNTRACK_SNMP=y                # SNMP 连接跟踪辅助
