+CONFIG_IP_VS_SH=y                         # 源哈希
+CONFIG_IP_VS_SED=y                        # 最短期望延迟
+CONFIG_IP_VS_NQ=y                         # 永不排队
+CONFIG_IP_VS_TWOS=y                       # 双调度（Two-Scheduler）
+CONFIG_IP_VS_MH=y                         # Maglev 哈希
+CONFIG_IP_VS_NFCT=y                       # 与连接跟踪集成
+CONFIG_IP_VS_FTP=y                        # FTP 辅助协议支持
+CONFIG_IP_VS_PE_SIP=y                     # SIP 持久性引擎
+
+### 队列调度（QoS / TC）
+CONFIG_NET_SCH_HFSC=y                     # HFSC 队列（层次化公平服务曲线）
+CONFIG_NET_SCH_RED=y                      # RED（随机早期检测）
+CONFIG_NET_SCH_SFB=y                      # SFB（随机公平蓝）
